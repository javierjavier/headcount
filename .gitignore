# Photo data — never commit (huge, and contains a child's face/GPS data)
# no trailing slash: also matches album and reference when they are symlinks (README suggests one)
album
matches/
*-matches/
reference
known-positives/

# Everything generated from the album (face data, montages, names, thumbnails)
work/
# Exports you pull out of the album
query*/
by_child*/

# Generated files from before work/ existed. The tool moves them into work/ on
# its first run; they stay ignored so leftovers can never be committed.
reference_embeddings.npy
scores.csv
# whole-class face database (clustering pipeline) — every child's biometric data
faces*.emb
faces*.npy
faces*.csv
faces*.done
faces*.hashes
clusters*.csv
labels*.csv
image_people*.csv
video_people*.csv
video_people*.done
scene*.csv
# backups of the above (review/cluster write *.bak) — same biometric content
*.bak
embed_full.log
clusters*/
validation_*.jpg
# face-crop review sheets + their coordinate dumps (sweep/QA) — biometric
suspect_*.jpg
suspect_*.csv
*.log
# local `serve` thumbnail cache — derived face thumbnails
.serve_cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store
